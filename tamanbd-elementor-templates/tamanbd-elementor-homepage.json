      ]
    },
    {
      "id": "tmb_sec_promo_band",
      "elType": "container",
      "settings": { "background_background": "classic", "background_color": "#0F4C3A", "padding": { "top": "56", "right": "24", "bottom": "56", "left": "24", "unit": "px", "isLinked": false } },
      "elements": [
        {
          "id": "tmb_w_offer_heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": { "title": "Complimentary Dhaka Metro Delivery Above ৳2,500", "title_color": "#FFFFFF" }
        },
        {
          "id": "tmb_w_offer_text",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": { "editor": "<p style=\"color:rgba(255,255,255,0.88);\">Pay securely with Cash on Delivery upon parcel inspection, or settle instantly via bKash and Nagad.</p>" }
        },
        {
          "id": "tmb_w_offer_btn",
          "elType": "widget",
          "widgetType": "button",
          "settings": { "text": "Explore Special Offers", "link": { "url": "/shop/" }, "background_color": "#FFFFFF", "button_text_color": "#0F4C3A" }
        }
      ]
    },
    {
      "id": "tmb_sec_pillars",
      "elType": "container",
      "settings": { "background_background": "classic", "background_color": "#FFFFFF", "padding": { "top": "56", "right": "24", "bottom": "56", "left": "24", "unit": "px", "isLinked": false } },
      "elements": [
        {
          "id": "tmb_w_pillars",
          "elType": "widget",
          "widgetType": "tmb-why-choose-us",
          "settings": { "kicker": "Service Standards", "heading": "Why Choose TamanBD", "columns": "4" }
        }
      ]
    },
    {
      "id": "tmb_sec_reviews",
      "elType": "container",
      "settings": { "padding": { "top": "56", "right": "24", "bottom": "56", "left": "24", "unit": "px", "isLinked": false } },
      "elements": [
        {
          "id": "tmb_w_reviews",
          "elType": "widget",
          "widgetType": "tmb-testimonials",
          "settings": { "kicker": "Verified Buyers", "heading": "Customer Reviews", "source_mode": "wc_reviews", "limit": 3, "columns": "3" }
        }
      ]
    },
    {
      "id": "tmb_sec_blog",
      "elType": "container",
      "settings": { "background_background": "classic", "background_color": "#FFFFFF", "padding": { "top": "56", "right": "24", "bottom": "56", "left": "24", "unit": "px", "isLinked": false } },
      "elements": [
        {
          "id": "tmb_w_blog",
          "elType": "widget",
          "widgetType": "tmb-blog-posts",
          "settings": { "kicker": "Editorial Journal", "heading": "Latest Blog Posts", "posts_count": 3, "columns": "3" }
        }
      ]
    },
    {
      "id": "tmb_sec_newsletter",
      "elType": "container",
      "settings": { "padding": { "top": "56", "right": "24", "bottom": "56", "left": "24", "unit": "px", "isLinked": false } },
      "elements": [
        {
          "id": "tmb_w_newsletter",
          "elType": "widget",
          "widgetType": "tmb-newsletter",
          "settings": { "heading": "Receive New Artisan Drops & Seasonal Offers", "button_text": "Subscribe" }
